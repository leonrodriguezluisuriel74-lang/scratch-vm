<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simulador de Banca Móvil con IA</title>
    <!-- Carga de Tailwind CSS para un diseño responsive y moderno -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Configuración de color para la app bancaria */
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'app-primary': '#4f46e5', /* Indigo principal */
                        'app-secondary': '#8b5cf6', /* Violeta secundario */
                        'app-bg': '#f3f4f6', /* Fondo claro */
                        'app-card': '#ffffff', /* Fondo de tarjetas */
                    },
                    /* Gradiente usado en el header */
                    backgroundImage: theme => ({
                        'header-gradient': `linear-gradient(to right, ${theme('colors.app-primary')}, ${theme('colors.app-secondary')})`,
                    })
                }
            }
        }

        /* Estilos base para simular la aplicación móvil */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #e5e7eb;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            min-height: 100vh;
            padding-top: 20px;
        }
        .app-container {
            width: 100%;
            max-width: 400px; /* Tamaño de móvil */
            min-height: 90vh;
            background-color: #ffffff;
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.2);
            border-radius: 20px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            position: relative;
        }
        .header {
            background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%"><defs><linearGradient id="g" x2="1" y2="0"><stop offset="0" stop-color="%234f46e5"/><stop offset="1" stop-color="%238b5cf6"/></linearGradient></defs><rect width="100%" height="100%" fill="url(%23g)"/></svg>');
            background-size: cover;
            color: white;
            padding: 16px;
            text-align: center;
            font-size: 1.1em;
            font-weight: 600;
        }
        .content {
            flex-grow: 1;
            padding: 20px;
            overflow-y: auto;
        }
        .nav-bar {
            display: flex;
            justify-content: space-around;
            padding: 10px 0;
            border-top: 1px solid #e5e7eb;
            background-color: white;
            z-index: 10;
        }
        .nav-button {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: #9ca3af; /* Gris por defecto */
            font-size: 0.75em;
            cursor: pointer;
            transition: color 0.2s;
        }
        .nav-button.active {
            color: #4f46e5; /* Indigo activo */
            font-weight: 600;
        }
        /* Para mensajes modales o temporales (sustituto de alert) */
        #message-box {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background-color: #10b981;
            color: white;
            padding: 15px 30px;
            border-radius: 12px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
            z-index: 1000;
            opacity: 0;
            transition: opacity 0.3s, transform 0.3s;
            pointer-events: none;
        }
        #message-box.show {
            opacity: 1;
            transform: translate(-50%, -50%) scale(1.05);
            pointer-events: auto;
        }
    </style>
</head>
<body>

<div class="app-container">
    <div class="header">
        Mi Banca Móvil
    </div>

    <!-- Contenido Principal Dinámico -->
    <div id="content-area" class="content">
        <!-- El contenido de las pestañas se inyecta aquí -->
